# Alima Docker Environment Configuration
# Copy this file to .env and fill in your values

# Application Settings
APP_NAME=Alima
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
DOMAIN=https://your-domain.com
ENVIRONMENT=production

# Database (SQLite is default, can use PostgreSQL if needed)
DATABASE_URL=sqlite:///data/db/alima.db
# DATABASE_URL=postgresql://user:password@postgres:5432/alima

# Email Configuration (Optional - for notifications and invites)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Sync Settings
SYNC_INTERVAL_HOURS=6
DOWNLOAD_QUALITY=High
MAX_CONCURRENT_DOWNLOADS=3

# Session Settings
SESSION_EXPIRE_HOURS=12410
INVITE_EXPIRE_DAYS=7

# Replication Mode (standalone/master/slave)
REPLICATION_MODE=standalone
MASTER_URL=
MASTER_API_KEY=
SLAVE_INSTANCES=
REPLICATION_SYNC_INTERVAL_MINUTES=15
REPLICATION_METHOD=http
RSYNC_USER=
RSYNC_HOST=
RSYNC_PATH=
