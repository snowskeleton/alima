# ============================================
# REQUIRED SETTINGS
# ============================================
# These are the ONLY settings needed in .env
# All other settings should be configured via Admin → Server Settings

# Application secret key for encryption and sessions
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32

# Full URL where the app is hosted
# Use https:// if behind a reverse proxy with SSL
DOMAIN=https://your-domain.com

# ============================================
# OPTIONAL SYSTEM SETTINGS
# ============================================

# Environment: development, production, testing
ENVIRONMENT=production

# Database connection string (PostgreSQL)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://alima:changeme@postgres:5432/alima

# PostgreSQL credentials (used by docker-compose)
POSTGRES_DB=alima
POSTGRES_USER=alima
POSTGRES_PASSWORD=changeme

# File storage paths (usually don't need to change these)
# AUDIOBOOKS_PATH=/app/data/audiobooks
# COVERS_PATH=/app/data/covers
# AUDIBLE_AUTH_PATH=/app/data/audible_auth
# TEMP_PATH=/app/data/temp

# ============================================
# NOTE: All other settings (email, sync, downloads, etc.)
# should be configured via the web UI at:
# Admin → Server Settings
# ============================================

# Replication Mode (standalone/master/slave)
REPLICATION_MODE=standalone

# Master Configuration (for slave instances)
# MASTER_URL=https://master.alima.example.com
# MASTER_API_KEY=change-this-api-key

# Slave Configuration (for master instances)
# SLAVE_INSTANCES=https://slave1.alima.example.com,https://slave2.alima.example.com

# Sync Settings
REPLICATION_SYNC_INTERVAL_MINUTES=15
REPLICATION_METHOD=http

# Optional: rsync configuration (only needed if REPLICATION_METHOD=rsync)
# RSYNC_USER=snow
# RSYNC_HOST=richmond
# RSYNC_PATH=/var/www/snowden/
