{
  "name": "alima-frontend",
  "version": "1.0.0",
  "description": "Frontend assets for Alima",
  "private": true,
  "scripts": {
    "build": "esbuild app/static/js/src/import.js --bundle --outfile=app/static/js/import.bundle.js --format=esm --minify",
    "watch": "esbuild app/static/js/src/import.js --bundle --outfile=app/static/js/import.bundle.js --format=esm --watch",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@uppy/core": "^4.3.3",
    "@uppy/dashboard": "^4.1.3",
    "@uppy/xhr-upload": "^4.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.24.2"
  }
}
